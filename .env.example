# ==========================================
# FOMO API Configuration (fomoapi.io)
# ==========================================
FOMO_API_KEY=your_fomo_api_key_here
FOMO_CHAIN=solana
FOMO_REST_BASE_URL=https://api.fomoapi.io
FOMO_WS_URL=wss://api.fomoapi.io/ws/alerts

# ==========================================
# Discord Unified Bot (Feeds & Slash Commands)
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID= # Optional: Your Discord Server ID for instant command updates
DISCORD_WHALE_CHANNEL_ID=your_whale_alerts_channel_id
DISCORD_ALPHA_CHANNEL_ID=your_alpha_theses_channel_id
MIN_WHALE_TRADE_USD=3000

# ==========================================
# Solana & Jupiter Copy-Trading Engine
# ==========================================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_solana_wallet_base58_private_key
BOT_MODE=simulation # "simulation" or "live"
COPY_TRADE_AMOUNT_SOL=0.1
COPY_TRADE_SLIPPAGE_BPS=250 # 250 = 2.5% slippage
COPY_TRADE_TARGET_HANDLES= # Comma-separated list of FOMO handles (leave empty to auto-load top 5)

# ==========================================
# General
# ==========================================
LOG_LEVEL=info
